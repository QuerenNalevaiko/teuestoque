# Copie este arquivo para .env e preencha sua chave somente no arquivo local.
# Nunca coloque a chave no app Expo, no código-fonte ou no repositório.
GEMINI_API_KEY=

# Modelo estável documentado na Gemini API na data desta configuração.
# Verifique também quais modelos sua chave/conta pode chamar.
GEMINI_MODELO=gemini-3.5-flash-lite

# Porta local da API; a Vercel define sua própria variável PORT quando necessário.
PORT=3001

# Origens de desenvolvimento Expo Web.
# Adicione a origem HTTPS publicada do app na Vercel.
# Separe múltiplas origens por vírgula e não inclua barra no final.
CORS_ORIGENS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006